function [dX] = evolution(t, X, bc, flag_drag, flag_J2)
%Unzip

rr = X(1:3);            % [km] position vector
vv = X(4:6);            % [km/s] velocity vector
r  = norm(rr);          % [km] position magnitude

% Drag perturbation
if flag_drag
    f_drag = drag_acceleration(r - RE, vv, bc);  % [km/s^2]
else
    f_drag = 0;
end

% J2 perturbation
if flag_J2
    f_j2 = j2_acc(rr);                 % [km/s^2]
else
    f_j2 = 0;                          % [km/s^2]
end